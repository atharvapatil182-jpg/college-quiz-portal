# Copy this file to .env (same folder as config.py / run.py) and fill in
# your real values. .env is git-ignored, so your real keys never get
# committed - config.py loads them automatically on startup.

# -----------------------------------------------------------------------
# Flask secret key (change this to a long random string in production)
# -----------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string

# -----------------------------------------------------------------------
# AI Question Generator (Groq API - free tier)
# Get your free key at: https://console.groq.com -> API Keys
# -----------------------------------------------------------------------
GROQ_API_KEY=gsk_...7ugo

# Optional: override the default model (llama-3.1-8b-instant)
# Other fast free options: llama-3.1-70b-versatile, gemma2-9b-it
# GROQ_MODEL=llama-3.1-8b-instant

# -----------------------------------------------------------------------
# Email settings (Gmail with App Password recommended)
# Enable 2FA on your Google account, then generate an App Password at:
# https://myaccount.google.com/apppasswords
# -----------------------------------------------------------------------
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password-here
